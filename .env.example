# Port exposé sur la machine hôte (http://localhost:PORT)
PORT=
# Secret de signature HS256 des JWT : au moins 32 caractères aléatoires.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Durée de vie du jeton (15m, 1h...) : garder court
JWT_EXPIRES_IN=
